{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs = require('fs'); ['package-lock.json', 'yarn.lock'].forEach(f => fs.existsSync(f) && fs.unlinkSync(f)); if (!/pnpm/.test(process.env.npm_config_user_agent || '')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r --filter \"@workspace/medway\" run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm -r --filter \"@workspace/medway\" run typecheck"
  },
  "private": true,
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "x64"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}